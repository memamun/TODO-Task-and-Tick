    <string name="app_name_with_desc">কাজের তালিকা - টাস্ক ম্যানেজার</string>
    <string name="app_description">একটি আধুনিক, ব্যবহারে সহজ টাস্ক ম্যানেজমেন্ট অ্যাপ যা আপনাকে সংগঠিত ও উৎপাদনশীল থাকতে সাহায্য করে। বৈশিষ্ট্যগুলোর মধ্যে রয়েছে টাস্ক ক্যাটাগরি, অগ্রাধিকার, শেষ তারিখ, এবং নোটিফিকেশন।</string>
